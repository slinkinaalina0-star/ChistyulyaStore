<Page x:Class="ChistyulyaStore.Pages.AdministratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ChistyulyaStore.Pages"
      xmlns:convert="clr-namespace:ChistyulyaStore.Converts"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1500"
      Title="AdministratorPage"
      FontFamily="Segoe UI">

    <Page.Resources>
        <convert:DiscountPrice x:Key="DiscountPrice"/>
        <convert:DiscountColor x:Key="DiscountColor"/>
        <convert:DiscountToVisibility x:Key="DiscountToVisibility"/>
    </Page.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с поиском, сортировкой, фильтрацией -->
        <StackPanel Orientation="Horizontal" Margin="22,10,22,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="searchBox" TextChanged="searchBox_TextChanged" 
             Width="350" Margin="10"/>

            <TextBlock Text="Сортировка по&#10;количеству" 
               VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ComboBox x:Name="sortBox" Width="200" Margin="10" 
              SelectionChanged="sortBox_SelectionChanged">
                <ComboBoxItem>по возрастанию</ComboBoxItem>
                <ComboBoxItem>по убыванию</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="Фильтрация&#10;по поставщику" 
               VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ComboBox x:Name="filtrBox" Width="200" Margin="10" 
              SelectionChanged="filtrBox_SelectionChanged"
              DisplayMemberPath="SuppliersName"/>

            <TextBlock x:Name="FIOBlock" Text="" VerticalAlignment="Center" Margin="10,0,0,0"/>

            <!-- Новая кнопка для заказов -->
            <Button x:Name="ordersButton" Content="Заказы" 
            Click="ordersButton_Click" 
            Background="#20B2AA" Foreground="White"
            Margin="10" Padding="10,5"/>

            <Button x:Name="goBackButton" Content="Назад" 
            Click="goBackButton_Click" 
            Background="#20B2AA" Foreground="White"
            Margin="10" Padding="10,5"/>
        </StackPanel>

        <!-- Список товаров -->
        <ListView Grid.Row="1" Margin="10,0,10,10" Name="productList" 
                  SelectionChanged="productList_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#20B2AA" BorderThickness="2" Width="600"
                            Background="{Binding ., Converter={StaticResource DiscountColor}}"
                            CornerRadius="8" Margin="5">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фото -->
                            <Border Grid.Column="0" Width="120" Height="120" 
                                    BorderBrush="#CCCCCC" BorderThickness="1" 
                                    CornerRadius="4" Background="#F5F5F5">
                                <Image Source="{Binding ProductImage}" 
                                       Width="110" Height="110" 
                                       Stretch="Uniform"/>
                            </Border>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <!-- Категория | Наименование -->
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Categories.CategoryName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding ProductName}"/>
                                </TextBlock>

                                <!-- Артикул -->
                                <TextBlock Margin="0,5,0,0" FontSize="12">
                                    <Run Text="Артикул: "/>
                                    <Run Text="{Binding Article}"/>
                                </TextBlock>

                                <!-- Кол-во на складе + ед.изм -->
                                <TextBlock Margin="0,5,0,0" FontSize="12">
                                    <Run Text="Кол-во на складе: "/>
                                    <Run Text="{Binding StockQuantity}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding UnitsOfMeasurement.Name}"/>
                                </TextBlock>

                                <!-- Поставщик | Производитель -->
                                <TextBlock Margin="0,5,0,0" FontSize="12">
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding Suppliers.SuppliersName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Manufacturers.ManufacturerName}"/>
                                </TextBlock>

                                <!-- Цены -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Цена: " FontSize="12"/>
                                    <!-- Зачёркнутая цена (видна только если есть скидка) -->
                                    <TextBlock Text="{Binding Price, StringFormat=' {0:F2} р.'}" 
                                               FontSize="12" Foreground="Gray" 
                                               TextDecorations="Strikethrough"
                                               Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibility}}"/>
                                    <!-- Цена со скидкой -->
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#20B2AA">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource DiscountPrice}" 
                                                          StringFormat=' {0:F2} р.'>
                                                <Binding Path="Price"/>
                                                <Binding Path="Discount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Блок со скидкой (виден только если есть скидка) -->
                                <Border Background="#FF7F50" CornerRadius="4" 
                                        Padding="6,2" HorizontalAlignment="Left"
                                        Margin="0,5,0,0"
                                        Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibility}}">
                                    <TextBlock Text="{Binding Discount, StringFormat='Скидка {0}%'}" 
                                               Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижняя панель с кнопками -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Name="countText" Text="0 из 0" 
                       FontSize="14" Foreground="#333" 
                       VerticalAlignment="Center" Margin="10,0,20,0"/>
            <Button x:Name="addButton" Content="Добавить товар" 
                    Click="addButton_Click" 
                    Background="#20B2AA" Foreground="White"
                    Width="150" Margin="10" Padding="10,5"/>
            <Button x:Name="deleteButton" Content="Удалить товар" 
                    Click="deleteButton_Click" 
                    Background="#20B2AA" Foreground="White"
                    Width="150" Margin="10" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Page>