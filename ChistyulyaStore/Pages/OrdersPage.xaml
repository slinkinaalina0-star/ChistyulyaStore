<Page x:Class="ChistyulyaStore.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление заказами"
      FontFamily="Segoe UI">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#00CED1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="FIOBlock" Text="" VerticalAlignment="Center" Margin="10" Foreground="White"/>
                <Button x:Name="goBackButton" Content="Назад" Click="goBackButton_Click" Background="#20B2AA" Foreground="White" Margin="5" Padding="10,5"/>
            </StackPanel>
        </Border>

        <!-- Панель сортировки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="22,10">
            <TextBlock Text="Сортировка по сумме:" VerticalAlignment="Center"/>
            <ComboBox x:Name="sortBox" Width="150" Margin="10,0,0,0" SelectionChanged="sortBox_SelectionChanged">
                <ComboBoxItem>по возрастанию</ComboBoxItem>
                <ComboBoxItem>по убыванию</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Список заказов с ПОДСВЕТКОЙ СТРОК -->
        <ListView Grid.Row="1" Margin="10" Name="ordersList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{Binding RowColor}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№ заказа" Width="80" DisplayMemberBinding="{Binding ID_Order}"/>
                    <GridViewColumn Header="Дата заказа" Width="120" DisplayMemberBinding="{Binding OrderDate}"/>
                    <GridViewColumn Header="Клиент" Width="200" DisplayMemberBinding="{Binding ClientFIO}"/>
                    <GridViewColumn Header="Сумма" Width="100" DisplayMemberBinding="{Binding TotalSum, StringFormat={}{0:F2} руб}"/>
                    <GridViewColumn Header="Статус" Width="120" DisplayMemberBinding="{Binding StatusName}"/>
                    <GridViewColumn Header="Код получения" Width="100" DisplayMemberBinding="{Binding PickUpCode}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="refreshButton" Content="Обновить" Click="refreshButton_Click" 
            Background="#20B2AA" Foreground="White" Margin="5" Padding="10,5"/>
            <TextBlock x:Name="countText" Text="0 из 0" FontSize="14" Foreground="#333" Margin="10"/>

            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="20,0,10,0"/>
            <ComboBox x:Name="statusBox" Width="150" SelectedIndex="0">
                <ComboBoxItem Content="Новый" Tag="2"/>
                <ComboBoxItem Content="Завершен" Tag="1"/>
            </ComboBox>

            <Button x:Name="updateStatusButton" Content="Обновить статус" Click="updateStatusButton_Click" 
            Background="#20B2AA" Foreground="White" Margin="10,0,0,0" Padding="10,5"/>
            <Button x:Name="viewDetailsButton" Content="Просмотр заказа" 
        Click="viewDetailsButton_Click" 
        Background="#20B2AA" Foreground="White" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Page>