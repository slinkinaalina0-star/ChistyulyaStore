<Page x:Class="ChistyulyaStore.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChistyulyaStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="0" d:DesignWidth="800"
      Title="AuthorizationPage"
      FontFamily="Segoe UI">

    <Grid Background="#00CED1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип и название -->
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,20">
            <TextBlock Text="Чистюля" FontSize="25" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,10"/>
            <TextBlock Text="Авторизация" FontSize="16" 
                       HorizontalAlignment="Center" Foreground="#555"/>
        </StackPanel>

        <!-- Форма входа -->
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
            <TextBlock Text="Логин" FontSize="14" Margin="0,5"/>
            <TextBox x:Name="emailBox" Margin="0,5" Padding="10" 
                     FontSize="14"/>

            <TextBlock Text="Пароль" FontSize="14" Margin="0,10,0,5"/>
            <PasswordBox x:Name="passwordBox" Margin="0,5" Padding="10" 
                         FontSize="14"/>

            <Button x:Name="enterButton" Content="Вход" 
                    Click="enterButton_Click" 
                    Background="#20B2AA" Foreground="White" 
                    FontSize="16" Padding="10" Margin="0,20"/>

            <Button x:Name="guestButton" Content="Войти как гость" 
                    Click="guestButton_Click" 
                    Background="#FFFFFF" Foreground="#20B2AA" 
                    FontSize="14" Padding="8" Margin="0,5"/>
        </StackPanel>

        <!-- CAPTCHA панель -->
        <StackPanel x:Name="captchaPanel" Grid.Row="3" Grid.Column="1" 
                    Margin="0,10" Visibility="Collapsed">
            <TextBlock Text="Введите код с картинки" FontSize="12" 
                       Margin="0,5" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="captchaImage" Width="120" Height="40" 
                       Margin="5"/>
                <TextBox x:Name="captchaBox" Width="100" Margin="5" 
                         Padding="5" FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <!-- Сообщение о блокировке -->
        <TextBlock x:Name="blockMessage" Grid.Row="4" Grid.Column="1" 
                   Text="Доступ заблокирован на 10 секунд" 
                   Foreground="Red" FontSize="12" 
                   HorizontalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>