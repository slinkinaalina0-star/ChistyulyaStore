<Window x:Class="ChistyulyaStore.Windows.OrderViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя корзина" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#00CED1" Padding="15">
            <StackPanel>
                <TextBlock Text="Моя корзина" FontSize="24" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="clientNameText" FontSize="14" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,5"/>
            </StackPanel>
        </Border>

        <!-- Список товаров в корзине -->
        <ListView x:Name="cartItemsList" Grid.Row="1" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#20B2AA" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:F2} руб'}" />
                                <TextBlock Text="{Binding FinalPrice, StringFormat='Итоговая цена: {0:F2} руб'}" Foreground="#20B2AA"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                                <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="50" TextAlignment="Center"/>
                                <TextBlock Text=" шт" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Удалить" Tag="{Binding}" 
                                    Click="RemoveItem_Click"
                                    Background="#FF7F50" Foreground="White" 
                                    Padding="10,5" Margin="10" Width="80"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Итого и кнопки -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Итого к оплате:" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="finalTotalText" FontSize="18" FontWeight="Bold" Foreground="#20B2AA"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                    <Button x:Name="checkoutButton" Content="Оформить заказ" 
                            Click="checkoutButton_Click" 
                            Background="#20B2AA" Foreground="White"
                            Width="150" Padding="10" Margin="10"/>
                    <Button x:Name="continueButton" Content="Продолжить покупки" 
                            Click="continueButton_Click" 
                            Background="#CCCCCC" Foreground="Black"
                            Width="150" Padding="10" Margin="10"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>