<Window x:Class="ChistyulyaStore.Windows.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChistyulyaStore.Windows"
        mc:Ignorable="d"
        FontFamily="Segoe UI"
        Icon="/Images/chistulya_logo.png"
        Title="Добавление/Редактирование товара" Height="550" Width="900">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#00CED1">
            <Image Source="/Images/chistulya_logo.png" Width="50" Height="50" Margin="10"/>
            <TextBlock Text="Чистюля" FontSize="24" VerticalAlignment="Center" 
                       FontWeight="Black" Foreground="White"/>
        </StackPanel>

        <!-- Форма редактирования -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка - фото -->
            <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                <Image Name="imageBox" Width="200" Height="200" Margin="10" 
                       Source="/Images/picture.png"/>
                <Button Name="imageButton" Content="Загрузить фото" 
                        Click="imageButton_Click" 
                        Background="#20B2AA" Foreground="White"
                        Padding="10" Margin="10"/>
            </StackPanel>

            <!-- Правая колонка - поля -->
            <StackPanel Grid.Column="1" Margin="10">
                <!-- Артикул -->
                <TextBlock Text="Артикул" FontWeight="Bold" Margin="0,5"/>
                <TextBox Name="articleBox" Margin="0,5" Padding="5"/>

                <!-- Наименование товара -->
                <TextBlock Text="Наименование товара" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="nameBox" Margin="0,5" Padding="5"/>

                <!-- Категория -->
                <TextBlock Text="Категория" FontWeight="Bold" Margin="0,10,0,5"/>
                <ComboBox Name="categoryBox" DisplayMemberPath="CategoryName" 
                          Margin="0,5" Padding="5"/>

                <!-- Производитель -->
                <TextBlock Text="Производитель" FontWeight="Bold" Margin="0,10,0,5"/>
                <ComboBox Name="manufacturerBox" DisplayMemberPath="ManufacturerName" 
                          Margin="0,5" Padding="5"/>

                <!-- Поставщик -->
                <TextBlock Text="Поставщик" FontWeight="Bold" Margin="0,10,0,5"/>
                <ComboBox Name="supplierBox" DisplayMemberPath="SuppliersName" 
                          Margin="0,5" Padding="5"/>

                <!-- Единица измерения -->
                <TextBlock Text="Единица измерения" FontWeight="Bold" Margin="0,10,0,5"/>
                <ComboBox Name="unitBox" DisplayMemberPath="Name" 
                          Margin="0,5" Padding="5"/>

                <!-- Цена -->
                <TextBlock Text="Цена (руб)" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="priceBox" Margin="0,5" Padding="5"/>

                <!-- Скидка -->
                <TextBlock Text="Скидка (%)" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="discountBox" Margin="0,5" Padding="5" Text="0"/>

                <!-- Количество на складе -->
                <TextBlock Text="Количество на складе" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="stockBox" Margin="0,5" Padding="5"/>

                <!-- Описание -->
                <TextBlock Text="Описание" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="descriptionBox" Margin="0,5" Padding="5" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                    <Button Name="saveButton" Content="Сохранить" 
                            Click="saveButton_Click" 
                            Background="#20B2AA" Foreground="White"
                            Width="120" Padding="10" Margin="10"/>
                    <Button Name="cancelButton" Content="Отмена" 
                            Click="cancelButton_Click" 
                            Background="#CCCCCC" Foreground="Black"
                            Width="120" Padding="10" Margin="10"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>